rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Security Rule to prevent IDOR and Privilege Escalation
    match /users/{userId} {
      // Users can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Users can create a profile, but cannot spoof a subscription
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.isSubscribed == false;
      
      // Prevent users from changing their subscription status or trial start date directly
      allow update: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isSubscribed', 'trialStart']));
      
      // A user can only access products inside their own subcollection
      match /products/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
